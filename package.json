{
  "name": "sinergia_dorada",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest --no-watch",
    "test:coverage": "vitest --no-watch --coverage",
    "test:axe": "vitest --no-watch tests/accessibility.test.js",
    "lint": "eslint scripts/**/*.js",
    "format:check": "prettier --check \"**/*.{js,json,css,md,html}\"",
    "format": "prettier --write \"**/*.{js,json,css,md,html}\"",
    "check:links": "node scripts/check-links.js",
    "validate:html": "html-validate index.html 404.html",
    "ci": "npm run test && npm run test:axe && npm run lint && npm run format:check && npm run validate:html && npm run build && npm run check:links",
    "build": "node scripts/copy-vendor.js && esbuild scripts/ui.js scripts/dogs.js scripts/content.js scripts/sentry.js scripts/sentry-sdk.js --bundle --format=iife --minify --sourcemap --outdir=dist",
    "prepare": "husky install"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@sentry/browser": "^10.31.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "html-validate": "^11.21.1",
    "husky": "^9.1.3",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.7.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wordcloud": "^1.2.2"
  }
}
