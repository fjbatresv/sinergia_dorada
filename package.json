{
  "name": "sinergia_dorada",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest --no-watch",
    "test:coverage": "vitest --no-watch --coverage",
    "test:axe": "vitest --no-watch tests/accessibility.test.js",
    "lint": "eslint scripts/**/*.js",
    "format:check": "prettier --check \"**/*.{js,json,css,md,html}\"",
    "format": "prettier --write \"**/*.{js,json,css,md,html}\"",
    "check:links": "sh -c 'python3 -m http.server 4173 >/dev/null 2>&1 & PID=$!; npx linkinator http://localhost:4173 --recurse --timeout 60000 --silent --skip \"https://.*\"; RC=$?; kill $PID; exit $RC'",
    "validate:html": "html-validate index.html",
    "build": "node scripts/copy-vendor.js && esbuild scripts/ui.js scripts/dogs.js scripts/content.js scripts/sentry.js --bundle --format=iife --minify --sourcemap --outdir=dist",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@sentry/browser": "^7.120.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@vitest/coverage-v8": "^4.0.13",
    "axe-core": "^4.9.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.13.0",
    "eslint-plugin-import": "^2.31.0",
    "html-validate": "^10.4.0",
    "husky": "^9.1.3",
    "jsdom": "^27.2.0",
    "lighthouse": "^12.8.2",
    "linkinator": "^4.0.3",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "vitest": "^4.0.13",
    "wordcloud": "^1.2.2"
  }
}
